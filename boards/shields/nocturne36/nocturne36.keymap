#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors.dtsi>

/ {
    behaviors {
        encoder_behavior: encoder_behavior{
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* --- Layer 0: Default (QWERTY + Volume Encoder) --- */
        default_layer {
            bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T             &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp A      &kp S      &kp D      &kp F      &kp G             &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp Z      &kp X      &kp C      &kp V      &kp B             &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLASH
                                   &kp LCTRL  &kp SPACE  &mo 1         &mo 2 ENTER  &kp BACKSPACE &kp RALT
            >;
            sensor-bindings = <&encoder_behavior PG_UP PG_DN>;
        };

        /* --- Layer 1: Function/Nav (Held via &mo 1) --- */
        fn_layer {
           bindings = <
                &kp Q      &kp W      &kp E      &kp R      &kp T             &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp A      &kp S      &kp D      &kp F      &kp G             &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp Z      &kp X      &kp C      &kp V      &kp B             &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLASH
                                   &kp LCTRL  &kp SPACE  &trans         &trans  &kp BACKSPACE &kp RALT
            >;
            sensor-bindings = <&encoder_behavior PG_UP PG_DN>;
        };

        /* --- Layer 2: Config (Bluetooth, Reset, Bootloader) --- */
        config_layer {
            bindings = <
               &kp Q      &kp W      &kp E      &kp R      &kp T             &kp Y      &kp U      &kp I      &kp O      &kp P
                &kp A      &bt BT_CLR      &&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2             &kp H      &kp J      &kp K      &kp L      &kp SEMI
                &kp Z      &kp X      &kp C      &kp V      &kp B             &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLASH
                                   &kp LCTRL  &kp SPACE  &trans         &trans  &kp BACKSPACE &kp RALT
            >;
            sensor-bindings = <&encoder_behavior PG_UP PG_DN>;
        };
    };
};